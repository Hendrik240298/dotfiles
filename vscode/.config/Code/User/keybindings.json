// Place your key bindings in this file to override the defaultsauto[]
[
    {
        "key": "alt+right",
        "command": "-workbench.action.terminal.focusNextPane",
        "when": "terminalFocus && terminalHasBeenCreated || terminalFocus && terminalProcessSupported"
    },
    {
        "key": "alt+right",
        "command": "editor.action.inlineSuggest.showNext"
    },
    {
        "key": "alt+right",
        "command": "-gitlens.key.alt+right",
        "when": "gitlens:key:alt+right"
    },
    {
        "key": "ctrl+shift+enter",
        "command": "github.copilot.generate",
        "when": "editorTextFocus && github.copilot.activated"
    },
    {
        "key": "ctrl+enter",
        "command": "-github.copilot.generate",
        "when": "editorTextFocus && github.copilot.activated"
    },
    {
        "key": "ctrl+space",
        "command": "editor.action.inlineSuggest.trigger",
        "when": "editorTextFocus && github.copilot.activated && vim.active && vim.mode == 'Insert'"
    },
    {
        "key": "space",
        "command": "whichkey.triggerKey",
        "args": " ",
        "when": "whichkeyVisible"
    },
    {
        "key": "alt+escape",
        "command": "interactive.input.clear",
        "when": "isCompositeNotebook && !LinkedEditingInputVisible && !accessibilityHelpWidgetVisible && !breakpointWidgetVisible && !editorHasMultipleSelections && !editorHasSelection && !editorHoverVisible && !exceptionWidgetVisible && !findWidgetVisible && !inSnippetMode && !inlineChatVisible && !isComposing && !markersNavigationVisible && !notebookEditorFocused && !notificationToastsVisible && !parameterHintsVisible && !renameInputVisible && !selectionAnchorSet && !suggestWidgetVisible"
    },
    {
        "key": "escape",
        "command": "-interactive.input.clear",
        "when": "isCompositeNotebook && !LinkedEditingInputVisible && !accessibilityHelpWidgetVisible && !breakpointWidgetVisible && !editorHasMultipleSelections && !editorHasSelection && !editorHoverVisible && !exceptionWidgetVisible && !findWidgetVisible && !inSnippetMode && !inlineChatVisible && !isComposing && !markersNavigationVisible && !notebookEditorFocused && !notificationToastsVisible && !parameterHintsVisible && !renameInputVisible && !selectionAnchorSet && !suggestWidgetVisible"
    },
    {
        "key": "alt+escape",
        "command": "notebook.cell.quitEdit",
        "when": "inputFocus && notebookEditorFocused && !editorHasMultipleSelections && !editorHasSelection && !editorHoverVisible && !inlineChatFocused"
    },
    {
        "key": "escape",
        "command": "-notebook.cell.quitEdit",
        "when": "inputFocus && notebookEditorFocused && !editorHasMultipleSelections && !editorHasSelection && !editorHoverVisible && !inlineChatFocused"
    },
    {
        "key": "alt+escape",
        "command": "notebook.cell.quitEdit",
        "when": "notebookEditorFocused && notebookOutputFocused"
    },
    {
        "key": "escape",
        "command": "-notebook.cell.quitEdit",
        "when": "notebookEditorFocused && notebookOutputFocused"
    },
    {
        "key": "escape",
        "command": "workbench.action.focusActiveEditorGroup",
        "when": "sideBarFocus || auxiliaryBarFocus"
    },
    {
        "key": "ctrl+c",
        "command": "workbench.action.focusActiveEditorGroup",
        "when": "sideBarFocus || auxiliaryBarFocus"
    },
    {
        "key": "space",
        "command": "whichkey.show",
        "when": "editorTextFocus && vim.active && vim.mode == 'Normal' && !suggestWidgetVisible && !renameInputVisible && !inSnippetMode && !whichkeyVisible"
    },
    {
        "key": "space",
        "command": "whichkey.show",
        "when": "editorTextFocus && vim.active && vim.mode == 'Visual' && !suggestWidgetVisible && !renameInputVisible && !inSnippetMode && !whichkeyVisible"
    },
    {
        "key": "space",
        "command": "whichkey.show",
        "when": "editorTextFocus && vim.active && vim.mode == 'VisualLine' && !suggestWidgetVisible && !renameInputVisible && !inSnippetMode && !whichkeyVisible"
    },
    {
        "key": "space",
        "command": "whichkey.show",
        "when": "activeEditorGroupEmpty && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && !terminalFocus && !whichkeyVisible"
    },
    {
        "key": "space",
        "command": "whichkey.show",
        "when": "notebookEditorFocused && !inputFocus && !whichkeyVisible"
    },
    {
        "key": "space",
        "command": "whichkey.show",
        "when": "sideBarFocus && !inputFocus && !whichkeyVisible"
    },
    {
        "key": "space",
        "command": "whichkey.show",
        "when": "auxiliaryBarFocus && !inputFocus && !whichkeyVisible"
    },
    {
        "key": "space",
        "command": "whichkey.show",
        "when": "panelFocus && !inputFocus && !whichkeyVisible"
    },
    {
        "key": "space",
        "command": "whichkey.show",
        "when": "activeWebviewPanelId == 'markdown.preview' && !whichkeyVisible"
    },
    {
        "key": "space",
        "command": "whichkey.show",
        "when": "activeCustomEditorId == 'vscode.markdown.preview.editor' && !whichkeyVisible"
    },
    {
        "key": "j",
        "command": "list.focusDown",
        "when": "listFocus && !inputFocus"
    },
    {
        "key": "k",
        "command": "list.focusUp",
        "when": "listFocus && !inputFocus"
    },
    {
        "key": "h",
        "command": "list.collapse",
        "when": "listFocus && !inputFocus"
    },
    {
        "key": "l",
        "command": "list.expand",
        "when": "listFocus && !inputFocus"
    }
]

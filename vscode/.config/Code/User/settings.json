{
    "editor.inlineSuggest.enabled": true,
    "diffEditor.ignoreTrimWhitespace": false,
    "cmake.configureOnOpen": true,
    "terminal.integrated.inheritEnv": false,
    "editor.minimap.enabled": false,
    "editor.lineNumbers": "relative",
    "workbench.startupEditor": "none",
    "powermode.enabled": true,
    "git.confirmSync": false,
    "git.autofetch": true,
    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "markdown": true,
        "scminput": false,
        "yaml": true
    },
    "cSpell.userWords": [
        "dofs",
        "multiphysics",
        "preconditioner"
    ],
    "[python]": {
        "editor.formatOnType": true
    },
    "editor.wordWrapColumn": 100,
    "editor.wordWrap": "on",
    "markdown-pdf.footerTemplate": "",
    "markdown-pdf.headerTemplate": "",
    "markdown-pdf.displayHeaderFooter": false,
    "extensions.ignoreRecommendations": true,
    "latex-workshop.linting.chktex.enabled": true,
    "latex-workshop.view.autoFocus.enabled": true,
    "ltex.additionalRules.enablePickyRules": true,
    "ltex.additionalRules.motherTongue": "de-DE",
    "liveshare.allowGuestDebugControl": true,
    "liveshare.allowGuestTaskControl": true,
    "liveshare.alwaysFollowHost": true,
    "liveshare.languages.allowGuestCommandControl": true,
    "liveshare.notebooks.allowGuestExecuteCells": true,
    "cmake.showOptionsMovedNotification": false,
    "editor.detectIndentation": false,
    "[latex]": {
        "editor.formatOnPaste": false,
        "editor.suggestSelection": "recentlyUsedByPrefix"
    },
    "latex-workshop.latex.autoBuild.run": "onSave",
    "git.openRepositoryInParentFolders": "never",
    "zenMode.hideLineNumbers": false,
    "githubPullRequests.createOnPublishBranch": "never",
    "githubIssues.queries": [
        {
            "label": "My Issues",
            "query": "default"
        },
        {
            "label": "Created Issues",
            "query": "author:${user} state:open repo:${owner}/${repository} sort:created-desc"
        },
        {
            "label": "Recent Issues",
            "query": "state:open repo:${owner}/${repository} sort:updated-desc"
        }
    ],
    "latex-workshop.message.information.show": true,
    "terminal.integrated.tabs.enabled": false,
    "jupyter.askForKernelRestart": false,
    "latex-workshop.latex.autoBuild.interval": 500,
    "workbench.sideBar.location": "right",
    "window.menuBarVisibility": "toggle",
    "ltex.additionalRules.languageModel": "de",
    "github.copilot.editor.enableAutoCompletions": false,
    "ltex.disabledRules": {

    },
    "ltex.enabledRules": {},
    "makefile.configureOnOpen": true,
    "latex-workshop.formatting.latex": "latexindent",
    "github.copilot.nextEditSuggestions.enabled": false,
    "chat.tools.terminal.autoApprove": {
        "python": true
    },
    "claudeCode.preferredLocation": "sidebar",
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1
    },
    "chat.viewSessions.orientation": "stacked",
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk",
            "command": "latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-pdf",
                "-outdir=%OUTDIR%",
                "%DOC%"
            ],
            "env": {}
        },
        {
            "name": "lualatexmk",
            "command": "latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-lualatex",
                "-outdir=%OUTDIR%",
                "%DOC%"
            ],
            "env": {}
        },
        {
            "name": "xelatexmk",
            "command": "latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-xelatex",
                "-outdir=%OUTDIR%",
                "%DOC%"
            ],
            "env": {}
        },
        {
            "name": "latexmk_rconly",
            "command": "latexmk",
            "args": [
                "%DOC%"
            ],
            "env": {}
        },
        {
            "name": "pdflatex",
            "command": "pdflatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "%DOC%"
            ],
            "env": {}
        },
        {
            "name": "bibtex",
            "command": "bibtex",
            "args": [
                "%DOCFILE%"
            ],
            "env": {}
        },
        {
            "name": "rnw2tex",
            "command": "Rscript",
            "args": [
                "-e",
                "knitr::opts_knit$set(concordance = TRUE); knitr::knit('%DOCFILE_EXT%')"
            ],
            "env": {}
        },
        {
            "name": "jnw2tex",
            "command": "julia",
            "args": [
                "-e",
                "using Weave; weave(\"%DOC_EXT%\", doctype=\"tex\")"
            ],
            "env": {}
        },
        {
            "name": "jnw2texminted",
            "command": "julia",
            "args": [
                "-e",
                "using Weave; weave(\"%DOC_EXT%\", doctype=\"texminted\")"
            ],
            "env": {}
        },
        {
            "name": "pnw2tex",
            "command": "pweave",
            "args": [
                "-f",
                "tex",
                "%DOC_EXT%"
            ],
            "env": {}
        },
        {
            "name": "pnw2texminted",
            "command": "pweave",
            "args": [
                "-f",
                "texminted",
                "%DOC_EXT%"
            ],
            "env": {}
        },
        {
            "name": "tectonic",
            "command": "tectonic",
            "args": [
                "--synctex",
                "--keep-logs",
                "--print",
                "%DOC%.tex"
            ],
            "env": {}
        }
    ],
    "latex-workshop.latex.recipes": [
        
        {
            "name": "pdflatex -> bibtex -> pdflatex * 2",
            "tools": [
                "pdflatex",
                "bibtex",
                "pdflatex",
                "pdflatex"
            ]
        },
        {
            "name": "latexmk",
            "tools": [
                "latexmk"
            ]
        },
        {
            "name": "latexmk (latexmkrc)",
            "tools": [
                "latexmk_rconly"
            ]
        },
        {
            "name": "latexmk (lualatex)",
            "tools": [
                "lualatexmk"
            ]
        },
        {
            "name": "latexmk (xelatex)",
            "tools": [
                "xelatexmk"
            ]
        },
        {
            "name": "Compile Rnw files",
            "tools": [
                "rnw2tex",
                "latexmk"
            ]
        },
        {
            "name": "Compile Jnw files",
            "tools": [
                "jnw2tex",
                "latexmk"
            ]
        },
        {
            "name": "Compile Pnw files",
            "tools": [
                "pnw2tex",
                "latexmk"
            ]
        },
        {
            "name": "tectonic",
            "tools": [
                "tectonic"
            ]
        }
    ],
    "vim.leader": "<space>",
    "vim.useSystemClipboard": true,
    "vim.useCtrlKeys": true,
    "vim.timeoutlen": 250,
    "vim.handleKeys": {
        "<C-p>": true
    },
    "whichkey.delay": 0,
    "whichkey.sortOrder": "none",
    "whichkey.bindings": [
        {
            "key": " ",
            "name": "Quick open",
            "type": "command",
            "command": "workbench.action.quickOpen"
        },
        {
            "key": "/",
            "name": "Find in file",
            "type": "command",
            "command": "actions.find"
        },
        {
            "key": "a",
            "name": "+AI",
            "type": "bindings",
            "bindings": [
                {
                    "key": "i",
                    "name": "Open chat",
                    "type": "command",
                    "command": "workbench.action.chat.open"
                }
            ]
        },
        {
            "key": "b",
            "name": "+Buffers",
            "type": "bindings",
            "bindings": [
                {
                    "key": "b",
                    "name": "Show all buffers",
                    "type": "command",
                    "command": "workbench.action.showAllEditorsByMostRecentlyUsed"
                },
                {
                    "key": "n",
                    "name": "New tab",
                    "type": "command",
                    "command": "workbench.action.files.newUntitledFile"
                }
            ]
        },
        {
            "key": "c",
            "name": "+Code",
            "type": "bindings",
            "bindings": [
                {
                    "key": "a",
                    "name": "Quick fix",
                    "type": "command",
                    "command": "editor.action.quickFix"
                }
            ]
        },
        {
            "key": "d",
            "name": "Problems",
            "type": "command",
            "command": "workbench.actions.view.problems"
        },
        {
            "key": "e",
            "name": "Explorer",
            "type": "command",
            "command": "workbench.view.explorer"
        },
        {
            "key": "f",
            "name": "+Files",
            "type": "bindings",
            "bindings": [
                {
                    "key": "f",
                    "name": "Find file",
                    "type": "command",
                    "command": "workbench.action.quickOpen"
                },
                {
                    "key": "r",
                    "name": "Open recent",
                    "type": "command",
                    "command": "workbench.action.openRecent"
                }
            ]
        },
        {
            "key": "g",
            "name": "+Git",
            "type": "bindings",
            "bindings": [
                {
                    "key": "g",
                    "name": "Source control",
                    "type": "command",
                    "command": "workbench.view.scm"
                },
                {
                    "key": "s",
                    "name": "Stage",
                    "type": "command",
                    "command": "git.stage"
                },
                {
                    "key": "u",
                    "name": "Unstage",
                    "type": "command",
                    "command": "git.unstage"
                },
                {
                    "key": "S",
                    "name": "Stage all",
                    "type": "command",
                    "command": "git.stageAll"
                },
                {
                    "key": "c",
                    "name": "Commit",
                    "type": "command",
                    "command": "git.commit"
                },
                {
                    "key": "p",
                    "name": "Push",
                    "type": "command",
                    "command": "git.push"
                },
                {
                    "key": "l",
                    "name": "Pull",
                    "type": "command",
                    "command": "git.pull"
                }
            ]
        },
        {
            "key": "h",
            "name": "+Horizontal",
            "type": "bindings",
            "bindings": [
                {
                    "key": "s",
                    "name": "Horizontal split",
                    "type": "command",
                    "command": "workbench.action.splitEditorDown"
                }
            ]
        },
        {
            "key": "n",
            "name": "+Notebook",
            "type": "bindings",
            "bindings": [
                {
                    "key": "a",
                    "name": "Run all cells",
                    "type": "command",
                    "command": "notebook.execute"
                },
                {
                    "key": "r",
                    "name": "Run cell",
                    "type": "command",
                    "command": "notebook.cell.execute"
                },
                {
                    "key": "i",
                    "name": "Interrupt kernel",
                    "type": "command",
                    "command": "jupyter.interruptkernel"
                },
                {
                    "key": "k",
                    "name": "Select kernel",
                    "type": "command",
                    "command": "notebook.selectKernel"
                }
            ]
        },
        {
            "key": "q",
            "name": "+Quit",
            "type": "bindings",
            "bindings": [
                {
                    "key": "q",
                    "name": "Close window",
                    "type": "command",
                    "command": "workbench.action.closeWindow"
                },
                {
                    "key": "e",
                    "name": "Close editor",
                    "type": "command",
                    "command": "workbench.action.closeActiveEditor"
                }
            ]
        },
        {
            "key": "r",
            "name": "+Refactor",
            "type": "bindings",
            "bindings": [
                {
                    "key": "n",
                    "name": "Rename",
                    "type": "command",
                    "command": "editor.action.rename"
                }
            ]
        },
        {
            "key": "s",
            "name": "+Search/SQL",
            "type": "bindings",
            "bindings": [
                {
                    "key": "s",
                    "name": "Object explorer",
                    "type": "command",
                    "command": "workbench.view.extension.objectExplorer"
                },
                {
                    "key": "q",
                    "name": "New SQL query",
                    "type": "command",
                    "command": "mssql.newQuery"
                },
                {
                    "key": "g",
                    "name": "Find in files",
                    "type": "command",
                    "command": "workbench.action.findInFiles"
                },
                {
                    "key": "c",
                    "name": "Command palette",
                    "type": "command",
                    "command": "workbench.action.showCommands"
                },
                {
                    "key": "b",
                    "name": "Toggle sidebar",
                    "type": "command",
                    "command": "workbench.action.toggleSidebarVisibility"
                }
            ]
        },
        {
            "key": "u",
            "name": "+UI",
            "type": "bindings",
            "bindings": [
                {
                    "key": "s",
                    "name": "Toggle sidebar",
                    "type": "command",
                    "command": "workbench.action.toggleSidebarVisibility"
                },
                {
                    "key": "v",
                    "name": "Toggle auxiliary bar",
                    "type": "command",
                    "command": "workbench.action.toggleAuxiliaryBar"
                },
                {
                    "key": "m",
                    "name": "Toggle menu bar",
                    "type": "command",
                    "command": "workbench.action.toggleMenuBar"
                }
            ]
        },
        {
            "key": "v",
            "name": "+Vertical",
            "type": "bindings",
            "bindings": [
                {
                    "key": "s",
                    "name": "Vertical split",
                    "type": "command",
                    "command": "workbench.action.splitEditorRight"
                }
            ]
        },
        {
            "key": "w",
            "name": "+Windows",
            "type": "bindings",
            "bindings": [
                {
                    "key": "s",
                    "name": "Horizontal split",
                    "type": "command",
                    "command": "workbench.action.splitEditorDown"
                },
                {
                    "key": "v",
                    "name": "Vertical split",
                    "type": "command",
                    "command": "workbench.action.splitEditorRight"
                },
                {
                    "key": "w",
                    "name": "Next window",
                    "type": "command",
                    "command": "workbench.action.focusNextGroup"
                },
                {
                    "key": "d",
                    "name": "Close window group",
                    "type": "command",
                    "command": "workbench.action.closeEditorsInGroup"
                },
                {
                    "key": "S",
                    "name": "Save file",
                    "type": "command",
                    "command": "workbench.action.files.save"
                }
            ]
        }
    ],
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": [
                "g",
                "d"
            ],
            "commands": [
                "editor.action.revealDefinition"
            ]
        },
        {
            "before": [
                "g",
                "r"
            ],
            "commands": [
                "editor.action.goToReferences"
            ]
        },
        {
            "before": [
                "g",
                "I"
            ],
            "commands": [
                "editor.action.goToImplementation"
            ]
        },
        {
            "before": [
                "K"
            ],
            "commands": [
                "editor.action.showHover"
            ]
        },
        {
            "before": [
                "[",
                "h"
            ],
            "commands": [
                "editor.action.dirtydiff.previous"
            ]
        },
        {
            "before": [
                "]",
                "h"
            ],
            "commands": [
                "editor.action.dirtydiff.next"
            ]
        },
        {
            "before": [
                "[",
                "d"
            ],
            "commands": [
                "editor.action.marker.prev"
            ]
        },
        {
            "before": [
                "]",
                "d"
            ],
            "commands": [
                "editor.action.marker.next"
            ]
        },
        {
            "before": [
                "<C-h>"
            ],
            "commands": [
                "workbench.action.focusLeftGroup"
            ]
        },
        {
            "before": [
                "<C-j>"
            ],
            "commands": [
                "workbench.action.focusBelowGroup"
            ]
        },
        {
            "before": [
                "<C-k>"
            ],
            "commands": [
                "workbench.action.focusAboveGroup"
            ]
        },
        {
            "before": [
                "<C-l>"
            ],
            "commands": [
                "workbench.action.focusRightGroup"
            ]
        }
    ],
    "mssql.openQueryResultsInTabByDefault": true,
    "mssql.connectionGroups": [
        {
            "name": "ROOT",
            "id": "ROOT"
        }
    ],
    "workbench.colorTheme": "Tokyo Night"
}
